# Normalize line endings
* text=auto

# Explicitly text files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.py text eol=lf
*.txt text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Git LFS — plate images
static/plates/full/*.jpg filter=lfs diff=lfs merge=lfs -text
static/plates/full/*.png filter=lfs diff=lfs merge=lfs -text
