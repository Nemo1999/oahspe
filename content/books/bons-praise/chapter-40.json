  "verses": [
    {
      "id": "bons-praise.40.1",
      "verse_number": 1,
      "en": "Praise be unto Thee, Jehovih! Who can search out the completeness of Thy creation?",
      "zh_hant": null,
      "zh_hans": null,
      "ja": null,
      "glossary_terms": [],
      "plate_ref": null,
      "notes": []
    },
    {
      "id": "bons-praise.40.2",
      "verse_number": 2,
      "en": "Or know the magnitude of Thy places, Thou Almighty! And thy endless inventions?",
      "zh_hant": null,
      "zh_hans": null,
      "ja": null,
      "glossary_terms": [],
      "plate_ref": null,
      "notes": []
    },
    {
      "id": "bons-praise.40.3",
      "verse_number": 3,
      "en": "Thou shalt be My theme forever, to find the far-seeing devices of my Creator, the work of my soul.",
      "zh_hant": null,
      "zh_hans": null,
      "ja": null,
      "glossary_terms": [],
      "plate_ref": null,
      "notes": []
    },
    {
      "id": "bons-praise.40.4",
      "verse_number": 4,
      "en": "I was alone in the world. Angels and men fed not my soul; I was hungered and in gloom.",
      "zh_hant": null,
      "zh_hans": null,
      "ja": null,
      "glossary_terms": [],
      "plate_ref": null,
      "notes": []
    },
    {
      "id": "bons-praise.40.5",
      "verse_number": 5,
      "en": "Then I turned to Thee, Thou Almighty. And Thou gavest me a new growth, a fruit of life in fire!",
      "zh_hant": null,
      "zh_hans": null,
      "ja": null,
      "glossary_terms": [],
      "plate_ref": null,
      "notes": []
    },
    {
      "id": "bons-praise.40.6",
      "verse_number": 6,
      "en": "Which grew brighter and brighter. And my vision was recovered, and Thy heavens were opened as a book is opened.",
      "zh_hant": null,
      "zh_hans": null,
      "ja": null,
      "glossary_terms": [],
      "plate_ref": null,
      "notes": []
    },
    {
      "id": "bons-praise.40.7",
      "verse_number": 7,
      "en": "And I drank of Thy waters, and ate of the tree of the resurrection to Thy everlasting kingdoms.",
      "zh_hant": null,
      "zh_hans": null,
      "ja": null,
      "glossary_terms": [],
      "plate_ref": null,
      "notes": []
    },
    {
      "id": "bons-praise.40.8",
      "verse_number": 8,
      "en": "The secret of Thy Wisdom, O Jehovih, was uncovered; the way of Thy Mightiness made imperishable forever!",
      "zh_hant": null,
      "zh_hans": null,
      "ja": null,
      "glossary_terms": [],
      "plate_ref": null,
      "notes": []
    }
  ]
